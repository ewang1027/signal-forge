# Copy to .env for local runs. In CI these come from GitHub Secrets.
#
# IMPORTANT: do NOT set ANTHROPIC_API_KEY. If it is present alongside
# CLAUDE_CODE_OAUTH_TOKEN it takes precedence and usage bills to the API
# account instead of the Max subscription.

CLAUDE_CODE_OAUTH_TOKEN=      # from: claude setup-token
RESEND_API_KEY=               # resend.com, free tier 3k/mo
DIGEST_TO=                    # where the digest lands
DIGEST_FROM=                  # verified sender on your resend domain
NTFY_TOPIC=                   # ntfy.sh topic (treat as a secret -- it is the auth)
STATE_REPO_PAT=               # PAT with repo scope on signal-forge-state
GITHUB_TOKEN=                 # for harvesting the GitHub API at 5k/hr
